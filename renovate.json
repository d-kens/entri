{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["/^org\\.springframework/"],
      "groupName": "Spring"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@angular/"],
      "groupName": "Angular"
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
