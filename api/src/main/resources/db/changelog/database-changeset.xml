    <changeSet id="202605240003" author="d-kens">
        <createTable tableName="events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="external_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="organizer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="venue_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="venue_city" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="venue_country" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="banner_url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="DATETIME"/>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="date_modified" type="DATETIME"/>
            <column name="modified_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="events"
                baseColumnNames="organizer_id"
                constraintName="fk_events_organizer"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="events"
                baseColumnNames="category_id"
                constraintName="fk_events_category"
                referencedTableName="event_categories"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="202605240004" author="d-kens">
        <createTable tableName="ticket_types">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="sold_quantity" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_quantity" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="max_tickets_per_order" type="INT"/>
            <column name="sale_start_date" type="DATETIME"/>
            <column name="sale_end_date" type="DATETIME"/>
            <column name="deleted_at" type="DATETIME"/>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="date_modified" type="DATETIME"/>
            <column name="modified_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="ticket_types"
                baseColumnNames="event_id"
                constraintName="fk_ticket_types_event"
                referencedTableName="events"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="202608080002" author="d-kens">
        <createTable tableName="event_ticket_reservations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="external_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(50)"/>
            <column name="expires_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="date_modified" type="DATETIME"/>
            <column name="modified_by" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

    <changeSet id="202608080003" author="d-kens">
        <createTable tableName="event_ticket_reservation_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reservation_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ticket_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="event_ticket_reservation_items"
                baseColumnNames="reservation_id"
                referencedTableName="event_ticket_reservations"
                referencedColumnNames="id"
                constraintName="fk__reservation_items__reservation"/>

        <addForeignKeyConstraint
                baseTableName="event_ticket_reservation_items"
                baseColumnNames="ticket_type_id"
                referencedTableName="ticket_types"
                referencedColumnNames="id"
                constraintName="fk__reservation_items__ticket_type"/>

        <createIndex
                tableName="event_ticket_reservation_items"
                indexName="idx__reservation_items__ticket_type">
            <column name="ticket_type_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="202608110002" author="d-kens">
        <addColumn tableName="event_ticket_reservations">
            <column name="event_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="event_ticket_reservations"
                baseColumnNames="event_id"
                referencedTableName="events"
                referencedColumnNames="id"
                constraintName="fk_reservation_event"/>
    </changeSet>


    <changeSet id="202608120001" author="d-kens">
        <createIndex tableName="event_ticket_reservations"
                     indexName="idx_reservations_status_expires_at">
            <column name="status"/>
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="202608280001" author="d-kens">
        <addColumn tableName="users">
            <column name="wallet_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="202608120002" author="d-kens">
        <createTable tableName="shedlock">
            <column name="name" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lock_until" type="TIMESTAMP(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_at" type="TIMESTAMP(3)" defaultValueComputed="CURRENT_TIMESTAMP(3)">
                <constraints nullable="false"/>
            </column>
            <column name="locked_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
