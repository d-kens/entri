<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="create-delivery-batches-table" author="d.onyango">
        <createTable tableName="delivery_batches">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="external_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="route_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>

            <column name="driver_name" type="VARCHAR(100)"/>
            <column name="driver_phone" type="VARCHAR(15)"/>

            <column name="created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="delivery_batches"
                baseColumnNames="route_id"
                referencedTableName="delivery_routes"
                referencedColumnNames="id"
                constraintName="fk_delivery_batches_route"/>

        <rollback>
            <dropTable tableName="delivery_batches"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
