<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <!-- SEED ZONES -->
    <changeSet id="seed-zones" author="d.onyango">
        <insert tableName="zones">
            <column name="zone_name" value="South B"/>
            <column name="city" value="Nairobi"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="zones">
            <column name="zone_name" value="Kilimani"/>
            <column name="city" value="Nairobi"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="zones">
            <column name="zone_name" value="Kasarani"/>
            <column name="city" value="Nairobi"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="zones">
            <column name="zone_name" value="Roysambu"/>
            <column name="city" value="Nairobi"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="zones">
            <column name="zone_name" value="Lower Kabete"/>
            <column name="city" value="Nairobi"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="zones">
            <column name="zone_name" value="Imara Daima"/>
            <column name="city" value="Nairobi"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

        <rollback>
            <delete tableName="zones">
                <where>zone_name IN ('South B','Kilimani','Kasarani','Roysambu','Lower Kabete','Imara Daima')</where>
            </delete>
        </rollback>
    </changeSet>

    <!-- SEED AGENTS POINTS -->
    <changeSet id="seed-agents" author="d.onyango">
        <!-- Example: generate 1-2 points per zone -->
        <insert tableName="agents">
            <column name="name" value="South B Depot"/>
            <column name="zone_id" valueNumeric="1"/>
            <column name="agent_id" valueNumeric="1"/>
            <column name="latitude" valueNumeric="-1.3195"/>
            <column name="longitude" valueNumeric="36.8456"/>
            <column name="address_description" value="South B main depot"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="phone" value="0722000001"/>
            <column name="opening_time" value="08:00:00"/>
            <column name="closing_time" value="18:00:00"/>
            <column name="created_at" valueDate="2026-02-06 00:00:00"/>
            <column name="updated_at" valueDate="2026-02-06 00:00:00"/>
        </insert>

        <insert tableName="agents">
            <column name="name" value="Kilimani Hub"/>
            <column name="zone_id" valueNumeric="2"/>
            <column name="agent_id" valueNumeric="2"/>
            <column name="latitude" valueNumeric="-1.2921"/>
            <column name="longitude" valueNumeric="36.7887"/>
            <column name="address_description" value="Kilimani parcel hub"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="phone" value="0722000002"/>
            <column name="opening_time" value="08:00:00"/>
            <column name="closing_time" value="18:00:00"/>
            <column name="created_at" valueDate="2026-02-06 00:00:00"/>
            <column name="updated_at" valueDate="2026-02-06 00:00:00"/>
        </insert>

        <rollback>
            <delete tableName="agents">
                <where>name IN ('South B Depot','Kilimani Hub')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
