<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="add-provider-transaction-id-to-payments" author="d.onyango">

        <addColumn tableName="payments">
            <column name="provider_transaction_id" type="VARCHAR(100)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="payments" columnName="provider_transaction_id"/>
        </rollback>

    </changeSet>

</databaseChangeLog>