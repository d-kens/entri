<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">
    <changeSet id="create-zones-table" author="d.onyango">
        <createTable tableName="zones">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="zone_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="is_cbd" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="city" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>

        </createTable>

        <addUniqueConstraint
                tableName="zones"
                columnNames="zone_name, city"
                constraintName="uc_zone_name_city"/>

        <rollback>
            <dropTable tableName="zones"/>
        </rollback>
    </changeSet>

</databaseChangeLog>