<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">
    <changeSet id="create-otp-table" author="d.onyango">
        <createTable tableName="otp">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="otp_hash" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>

            <column name="purpose" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="request_ip" type="VARCHAR(45)"/>

            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="used_at" type="TIMESTAMP"/>
            <column name="invalidated_at" type="TIMESTAMP"/>

            <column name="created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>

        </createTable>

        <!-- Foreign key -->
        <addForeignKeyConstraint
                baseTableName="otp"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_otp_user"/>

        <!-- Rollback -->
        <rollback>
            <dropTable tableName="otp"/>
        </rollback>
    </changeSet>

</databaseChangeLog>