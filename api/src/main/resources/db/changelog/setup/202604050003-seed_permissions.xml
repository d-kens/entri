<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="seed-permissions" author="d.onyango">
        <!-- Permissions -->
        <insert tableName="permissions"><column name="name" value="delivery:read"/></insert>
        <insert tableName="permissions"><column name="name" value="delivery:create"/></insert>
        <insert tableName="permissions"><column name="name" value="delivery:update"/></insert>
        <insert tableName="permissions"><column name="name" value="user:read"/></insert>
        <insert tableName="permissions"><column name="name" value="user:create"/></insert>
        <insert tableName="permissions"><column name="name" value="user:update"/></insert>
        <insert tableName="permissions"><column name="name" value="user:delete"/></insert>

        <rollback>
            <delete tableName="permissions">
                <where>name IN ('delivery:read','delivery:create','delivery:update','user:read','user:create','user:update','user:delete')</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="seed-role-permissions" author="d.onyango">
        <!-- ADMIN: all permissions -->
        <sql>INSERT INTO role_permissions (role_id, permission_id) SELECT r.id, p.id FROM roles r, permissions p WHERE r.name = 'ADMIN'</sql>

        <!-- MERCHANT: delivery:read, delivery:create -->
        <sql>INSERT INTO role_permissions (role_id, permission_id) SELECT r.id, p.id FROM roles r JOIN permissions p ON p.name IN ('delivery:read', 'delivery:create') WHERE r.name = 'MERCHANT'</sql>

        <!-- AGENT: delivery:read, delivery:update -->
        <sql>INSERT INTO role_permissions (role_id, permission_id) SELECT r.id, p.id FROM roles r JOIN permissions p ON p.name IN ('delivery:read', 'delivery:update') WHERE r.name = 'AGENT'</sql>

        <!-- RIDER: no permissions yet — batch/route permissions to be added when that feature is built -->

        <rollback>
            <delete tableName="role_permissions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
