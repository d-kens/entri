# Copy this file to scripts/secrets.local.env and fill in the real values.
# scripts/secrets.local.env is gitignored — never commit it.

# Path to the Firebase service account JSON file on your local machine.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/oro-web-app-firebase-adminsdk-fbsvc-8f2ea245fd.json

# Novu dashboard → Settings → API Keys
NOVU_SECRET=

# IntaSend dashboard → API keys / webhooks
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
