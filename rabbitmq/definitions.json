{
  "policies": [
    {
      "vhost": "/",
      "name": "notification.send",
      "pattern": "^notification\\.send$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "message-ttl": 86400000,
        "max-length": 10000,
        "dead-letter-exchange": "notification.dlx",
        "dead-letter-routing-key": "notification.failed"
      }
    },
    {
